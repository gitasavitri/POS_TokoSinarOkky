# Salin menjadi .env lalu isi. Jangan pernah commit file .env.
PORT=3000
HOST=127.0.0.1
# mysql://pengguna:sandi@host:3306/nama_database
DATABASE_URL=mysql://pos:ganti-sandi@127.0.0.1:3306/pos_pusat
# Isi 1 kalau server ada di belakang Caddy/Nginx (HTTPS).
TRUST_PROXY=1
# Server di PC Windows toko (bukan VPS): isi HOST=0.0.0.0 supaya PC kasir lain di jaringan toko bisa tersambung.
# Folder cadangan harian (windows\cadangan-server.ps1). Sebaiknya disk lain atau flashdisk.
CADANGAN_FOLDER=C:\POS-Cadangan-Server
